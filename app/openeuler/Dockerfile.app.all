## 包含所有应用的 app docker 镜像
## 基础镜像: docker pull docker.agiros.org.cn/agiros/${ROS_PREFIX}-${ROS_DISTRO}-openeuler-desktop:2606

##各个阶段规划
# Stage 1: base      → 基础环境（中间层）
# Stage 2: unitree   → 四足机器人（最终发布）
# Stage 3: ur5       → 机械臂（最终发布）
# Stage 4: wheeltec  → 轮趣小车（最终发布）
# Stage 5: uav       → 无人机（最终发布）

# =============================================================================
# 全局构建参数
# =============================================================================
ARG ROS_DISTRO=loong
ARG ROS_PREFIX=agiros
ARG WORKSPACE=/workspace/app
ARG USERNAME=ros
ARG IMAGE_TAG=2606
ARG NETWORK_INTERFACE_NAME=eth0
ARG OS=openeuler
ARG PARALLEL_JOBS=1


# =============================================================================
# Stage 1: BASE (最小运行环境)
# =============================================================================
FROM docker.agiros.org.cn/${ROS_PREFIX}/${ROS_PREFIX}-${ROS_DISTRO}-${OS}-desktop:${IMAGE_TAG} AS base

SHELL ["/bin/bash", "-exo", "pipefail", "-c"]

# Docker Buildx 自动注入的目标架构变量
ARG TARGETARCH
ARG TARGETPLATFORM

USER root

# 重新声明需要的 ARG
ARG ROS_DISTRO
ARG ROS_PREFIX
ARG USERNAME
ARG WORKSPACE
ARG NETWORK_INTERFACE_NAME

# 全局构建参数（用于 LABEL）
ARG BUILD_DATE
ARG GIT_COMMIT

ENV ROS_DISTRO=${ROS_DISTRO}
ENV WORKSPACE=${WORKSPACE}
ENV NETWORK_INTERFACE_NAME=${NETWORK_INTERFACE_NAME}

# openEuler 基础工具 + AGIROS 开发工具
RUN --mount=type=cache,target=/var/cache/dnf,sharing=locked \
    set -exo pipefail; \
    qemu-ldconfig-fix enable; \
    dnf -y update --exclude='hdf5*' --exclude='netcdf*' --exclude='vtk*'; \
    dnf -y --setopt=install_weak_deps=False install \
    vim nano net-tools \
    python3-pip  \
    python3-vcstool \
    gcc gcc-c++ cmake make git; \
    dnf clean all; \
    rm -rf /tmp/* /var/tmp/*; \
    qemu-ldconfig-fix disable

USER ${USERNAME}

# =============================================================================
# Stage 2: unitree app (完整应用环境)
# =============================================================================
FROM base AS unitree

SHELL ["/bin/bash", "-exo", "pipefail", "-c"]

ARG TARGETARCH
ARG TARGETPLATFORM

USER root

# 重新声明所有需要的 ARG
ARG ROS_DISTRO
ARG ROS_PREFIX
ARG USERNAME

##设置unitree workspace目录
ARG WORKSPACE=/workspace/app/unitree
ARG NETWORK_INTERFACE_NAME
ARG BUILD_DATE
ARG GIT_COMMIT
ARG PARALLEL_JOBS
ARG IMAGE_TAG
ARG OS

# 显式覆盖基础镜像继承的 Author 字段
LABEL maintainer="AGIROS Team <4384213@qq.com>"
# ========== 最终镜像 LABEL（仅在此处定义） ==========
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.authors="AGIROS Team <4384213@qq.com>"
LABEL org.opencontainers.image.vendor="AGIROS"
LABEL org.opencontainers.image.title="AGIROS Unitree Go2 Application"
LABEL org.opencontainers.image.description="Multi-architecture AGIROS ${ROS_DISTRO} application image with Unitree Go2 robot support. Includes AGIROS navigation, SLAM, and gesture control."
LABEL org.opencontainers.image.version="${IMAGE_TAG}"
LABEL org.opencontainers.image.revision="${GIT_COMMIT}"
LABEL org.opencontainers.image.source="https://github.com/agiros/agiros-docker"
LABEL org.opencontainers.image.licenses="Proprietary"
LABEL org.opencontainers.image.base.name="docker.agiros.org.cn/agiros/${ROS_PREFIX}-${ROS_DISTRO}-${OS}-desktop:${IMAGE_TAG}"
# 构建后可通过 skopeo 补充
LABEL org.opencontainers.image.base.digest=""  


ENV ROS_DISTRO=${ROS_DISTRO}
ENV ROS_PREFIX=${ROS_PREFIX}
ENV WORKSPACE=${WORKSPACE}
ENV NETWORK_INTERFACE_NAME=${NETWORK_INTERFACE_NAME}

RUN --mount=type=cache,target=/var/cache/dnf,sharing=locked \
    --mount=type=cache,target=/home/${USERNAME}/.cache/pip,uid=1000,gid=1000 \
    set -exo pipefail; \
    qemu-ldconfig-fix enable; \
    dnf -y update --exclude='hdf5*' --exclude='netcdf*' --exclude='vtk*'; \
    dnf -y --setopt=install_weak_deps=False install \
    yaml-cpp-devel \
    libpcap-devel \
    pcl-devel; \
    dnf clean all; \
    rm -rf /tmp/* /var/tmp/*; \
    pip3 install --no-cache-dir \
        numpy \
        scipy \
        transforms3d \
        pyserial \
        stable-baselines3 \
        opencv-python; \
    qemu-ldconfig-fix disable


# 时区设置
RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime

# AGIROS 包
RUN --mount=type=cache,target=/var/cache/dnf,sharing=locked \
    set -exo pipefail; \
    qemu-ldconfig-fix enable; \
    dnf -y update --exclude='hdf5*' --exclude='netcdf*' --exclude='vtk*'; \
    dnf -y --setopt=install_weak_deps=False install \
    ${ROS_PREFIX}-${ROS_DISTRO}-cyclonedds \
    ${ROS_PREFIX}-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    ${ROS_PREFIX}-${ROS_DISTRO}-navigation2 \
    ${ROS_PREFIX}-${ROS_DISTRO}-rosidl-generator-dds-idl \
    ${ROS_PREFIX}-${ROS_DISTRO}-nav2-bringup \
    ${ROS_PREFIX}-${ROS_DISTRO}-slam-toolbox \
    ${ROS_PREFIX}-${ROS_DISTRO}-realsense2-camera \
    ${ROS_PREFIX}-${ROS_DISTRO}-gazebo-ros-pkgs \
    ${ROS_PREFIX}-${ROS_DISTRO}-plotjuggler \
    ${ROS_PREFIX}-${ROS_DISTRO}-cartographer \
    ${ROS_PREFIX}-${ROS_DISTRO}-cartographer-ros-msgs \
    ${ROS_PREFIX}-${ROS_DISTRO}-cartographer-ros \
    ${ROS_PREFIX}-${ROS_DISTRO}-xacro; \
    dnf clean all; \
    rm -rf /tmp/* /var/tmp/*; \
    qemu-ldconfig-fix disable


# 创建工作空间并设置权限
RUN mkdir -p ${WORKSPACE}/src && chown -R ${USERNAME}:${USERNAME} ${WORKSPACE}

USER ${USERNAME}

# 配置用户环境（.bashrc）
RUN echo "source /opt/${ROS_PREFIX}/${ROS_DISTRO}/setup.bash" >> /home/${USERNAME}/.bashrc     && echo "source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash" >> /home/${USERNAME}/.bashrc     && echo "export ROS_DOMAIN_ID=0" >> /home/${USERNAME}/.bashrc     && echo "cd ${WORKSPACE}" >> /home/${USERNAME}/.bashrc

# 复制应用源码（使用 --chown 确保权限正确）
COPY --chown=${USERNAME}:${USERNAME} src/unitree ${WORKSPACE}/src

# 构建 cyclonedds_ws（不使用 cache mount 以确保构建产物固化到镜像中）
RUN set -exo pipefail; \
    cd ${WORKSPACE}/src/unitree_ros2/cyclonedds_ws \
    && mkdir -p log build install \
    && chown -R ${USERNAME}:${USERNAME} . \
    && source /opt/${ROS_PREFIX}/${ROS_DISTRO}/setup.bash \
    && colcon build --parallel-workers ${PARALLEL_JOBS} \
    && source install/setup.bash

# 构建 dog-bot（不使用 cache mount 和 --symlink-install，避免运行时 symlink 断裂）
RUN set -exo pipefail; \
    cd ${WORKSPACE} \
    && mkdir -p log build install \
    && chown -R ${USERNAME}:${USERNAME} . \
    && source /opt/${ROS_PREFIX}/${ROS_DISTRO}/setup.bash \
    && unset PYTHONDONTWRITEBYTECODE \
    && colcon build --parallel-workers ${PARALLEL_JOBS} \
    && source install/setup.bash


# Entrypoint 脚本（使用 RUN cat > 确保变量正确展开）
USER root
RUN cat > /ros_entrypoint.sh <<'ROS_EOF'
#!/bin/bash
set -e
source /opt/${ROS_PREFIX}/${ROS_DISTRO}/setup.bash
[ -f "${WORKSPACE}/install/setup.bash" ] && source ${WORKSPACE}/install/setup.bash
[ -f "${WORKSPACE}/src/unitree_ros2/cyclonedds_ws/install/setup.bash" ] && source ${WORKSPACE}/src/unitree_ros2/cyclonedds_ws/install/setup.bash
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export CYCLONEDDS_URI="<CycloneDDS><Domain><General><Interfaces><NetworkInterface name=\"${NETWORK_INTERFACE_NAME}\" priority=\"default\" multicast=\"default\" /></Interfaces></General></Domain></CycloneDDS>"
exec "$@"
ROS_EOF
RUN chmod +x /ros_entrypoint.sh

USER ${USERNAME}
WORKDIR ${WORKSPACE}
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD pgrep -f "agiros" || exit 1
ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]



# =============================================================================
# Stage 3: ur5 app 
# =============================================================================

FROM base AS ur5
SHELL ["/bin/bash", "-exo", "pipefail", "-c"]

ARG TARGETARCH TARGETPLATFORM
ARG ROS_DISTRO ROS_PREFIX USERNAME
ARG WORKSPACE=/workspace/app/ur5
ARG NETWORK_INTERFACE_NAME BUILD_DATE GIT_COMMIT PARALLEL_JOBS IMAGE_TAG OS


# 显式覆盖基础镜像继承的 Author 字段
LABEL maintainer="AGIROS Team <4384213@qq.com>"
# ========== 最终镜像 LABEL（仅在此处定义） ==========
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.authors="AGIROS Team <4384213@qq.com>"
LABEL org.opencontainers.image.vendor="AGIROS"
LABEL org.opencontainers.image.title="AGIROS UR5 Application"
LABEL org.opencontainers.image.description="Multi-architecture AGIROS ${ROS_DISTRO} application image with UR5 robot support. Includes AGIROS Moveit, yolo-ros ."
LABEL org.opencontainers.image.version="${IMAGE_TAG}"
LABEL org.opencontainers.image.revision="${GIT_COMMIT}"
LABEL org.opencontainers.image.source="https://github.com/agiros/agiros-docker"
LABEL org.opencontainers.image.licenses="Proprietary"
LABEL org.opencontainers.image.base.name="docker.agiros.org.cn/agiros/${ROS_PREFIX}-${ROS_DISTRO}-${OS}-desktop:${IMAGE_TAG}"


ENV ROS_DISTRO=${ROS_DISTRO}
ENV ROS_PREFIX=${ROS_PREFIX}
ENV WORKSPACE=${WORKSPACE}

USER root

# openEuler 开发依赖
RUN --mount=type=cache,target=/var/cache/dnf,sharing=locked \
    --mount=type=cache,target=/home/${USERNAME}/.cache/pip,uid=1000,gid=1000 \
    set -exo pipefail; \
    qemu-ldconfig-fix enable; \
    dnf -y update --exclude='hdf5*' --exclude='netcdf*' --exclude='vtk*'; \
    dnf -y --setopt=install_weak_deps=False install \
        python3-pip \
        wget \
        gnupg2 \
        fcl-devel; \
    dnf clean all; \
    rm -rf /tmp/* /var/tmp/*; \
    qemu-ldconfig-fix disable

RUN mkdir -p ${WORKSPACE}/src && chown -R ${USERNAME}:${USERNAME} ${WORKSPACE}

WORKDIR ${WORKSPACE}

USER ${USERNAME}

# .bashrc 配置
RUN echo "source /opt/${ROS_PREFIX}/${ROS_DISTRO}/setup.bash" >> /home/${USERNAME}/.bashrc && \
    echo "source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash" >> /home/${USERNAME}/.bashrc && \
    echo "export ROS_DOMAIN_ID=0" >> /home/${USERNAME}/.bashrc && \
    echo "export GAZEBO_MODEL_PATH=\$GAZEBO_MODEL_PATH:${WORKSPACE}/src" >> /home/${USERNAME}/.bashrc && \
    echo "export IGN_GAZEBO_RESOURCE_PATH=\$IGN_GAZEBO_RESOURCE_PATH:${WORKSPACE}/src" >> /home/${USERNAME}/.bashrc && \
    echo "export IGN_GAZEBO_RESOURCE_PATH=${WORKSPACE}/src/ur_robotiq_sim_gz/models:\$IGN_GAZEBO_RESOURCE_PATH" >> /home/${USERNAME}/.bashrc && \
    echo "cd ${WORKSPACE}" >> /home/${USERNAME}/.bashrc && \
    echo "source ${WORKSPACE}/install/setup.bash" >> /home/${USERNAME}/.bashrc

COPY --chown=${USERNAME}:${USERNAME} src/ur5 ${WORKSPACE}/src

USER root

# yolo_ros 依赖
RUN --mount=type=cache,target=/home/${USERNAME}/.cache/pip,uid=1000,gid=1000 \
    set -exo pipefail; \
    cd ${WORKSPACE}/src/yolo_ros/ && \
    pip3 install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple --default-timeout=1000 -r requirements.txt



# 构建（不使用 --symlink-install 避免运行时symlink断裂）
RUN --mount=type=cache,target=/var/cache/dnf,sharing=locked \
    set -exo pipefail; \
    qemu-ldconfig-fix enable; \
    su - ${USERNAME} -c "\
        cd ${WORKSPACE}; \
        mkdir -p log build install; \
        source /opt/${ROS_PREFIX}/${ROS_DISTRO}/setup.bash; \
        agirosdep update; \
        agirosdep install --from-paths src --ignore-src -r -y; \
        unset PYTHONDONTWRITEBYTECODE; \
        colcon build --parallel-workers ${PARALLEL_JOBS}; \
        source install/setup.bash; \
    "; \
    qemu-ldconfig-fix disable; \
    rm -rf /tmp/* /var/tmp/*

USER root
RUN cat > /ros_entrypoint.sh <<EOF
#!/bin/bash
set -e
source /opt/${ROS_PREFIX}/${ROS_DISTRO}/setup.bash
[ -f "${WORKSPACE}/install/setup.bash" ] && source ${WORKSPACE}/install/setup.bash
exec "$@"
EOF
RUN chmod +x /ros_entrypoint.sh

USER ${USERNAME}
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD pgrep -f "agiros" || exit 1
ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]

# =============================================================================
# Stage 4: wheeltec app 
# =============================================================================

FROM base AS wheeltec
SHELL ["/bin/bash", "-exo", "pipefail", "-c"]

ARG TARGETARCH TARGETPLATFORM
ARG ROS_DISTRO ROS_PREFIX USERNAME
ARG WORKSPACE=/workspace/app/wheeltec
ARG NETWORK_INTERFACE_NAME BUILD_DATE GIT_COMMIT PARALLEL_JOBS IMAGE_TAG OS


LABEL maintainer="AGIROS Team <4384213@qq.com>"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.authors="AGIROS Team <4384213@qq.com>"
LABEL org.opencontainers.image.vendor="AGIROS"
LABEL org.opencontainers.image.title="AGIROS Wheeltec Application"
LABEL org.opencontainers.image.description="Multi-architecture AGIROS ${ROS_DISTRO} application image with Wheeltec robot support. Includes navigation, aruco-ros, usb-cam."
LABEL org.opencontainers.image.version="${IMAGE_TAG}"
LABEL org.opencontainers.image.revision="${GIT_COMMIT}"
LABEL org.opencontainers.image.source="https://github.com/agiros/agiros-docker"
LABEL org.opencontainers.image.licenses="Proprietary"
LABEL org.opencontainers.image.base.name="docker.agiros.org.cn/agiros/${ROS_PREFIX}-${ROS_DISTRO}-${OS}-desktop:${IMAGE_TAG}"


ENV ROS_DISTRO=${ROS_DISTRO}
ENV ROS_PREFIX=${ROS_PREFIX}
ENV WORKSPACE=${WORKSPACE}

USER root

RUN --mount=type=cache,target=/var/cache/dnf,sharing=locked \
    --mount=type=cache,target=/home/${USERNAME}/.cache/pip,uid=1000,gid=1000 \
    set -exo pipefail; \
    qemu-ldconfig-fix enable; \
    dnf -y update --exclude='hdf5*' --exclude='netcdf*' --exclude='vtk*'; \
    dnf -y --setopt=install_weak_deps=False install \
        python3-pip \
        wget \
        gnupg2 \
        asio-devel \
        asio \
        libpcap-devel \
        alsa-lib-devel \
        libuvc-devel \
        usbutils \
        ${ROS_PREFIX}-${ROS_DISTRO}-nav* \
        ${ROS_PREFIX}-${ROS_DISTRO}-ackermann-msgs \
        ${ROS_PREFIX}-${ROS_DISTRO}-aruco-ros \
        ${ROS_PREFIX}-${ROS_DISTRO}-usb-cam \
        ${ROS_PREFIX}-${ROS_DISTRO}-image-publisher \
        ${ROS_PREFIX}-${ROS_DISTRO}-image-common \
        ${ROS_PREFIX}-${ROS_DISTRO}-magic-enum \
        ${ROS_PREFIX}-${ROS_DISTRO}-imu-filter-madgwick \
        ${ROS_PREFIX}-${ROS_DISTRO}-joint-state-publisher \
        ${ROS_PREFIX}-${ROS_DISTRO}-filters \
        ${ROS_PREFIX}-${ROS_DISTRO}-rtcm-msgs \
        ${ROS_PREFIX}-${ROS_DISTRO}-robot-localization \
        ${ROS_PREFIX}-${ROS_DISTRO}-serial; \
    dnf clean all; \
    rm -rf /tmp/* /var/tmp/*; \
    qemu-ldconfig-fix disable

RUN mkdir -p ${WORKSPACE}/src && chown -R ${USERNAME}:${USERNAME} ${WORKSPACE}

WORKDIR ${WORKSPACE}

USER ${USERNAME}

RUN echo "source /opt/${ROS_PREFIX}/${ROS_DISTRO}/setup.bash" >> /home/${USERNAME}/.bashrc && \
    echo "source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash" >> /home/${USERNAME}/.bashrc && \
    echo "export ROS_DOMAIN_ID=0" >> /home/${USERNAME}/.bashrc && \
    echo "cd ${WORKSPACE}" >> /home/${USERNAME}/.bashrc && \
    echo "source ${WORKSPACE}/install/setup.bash" >> /home/${USERNAME}/.bashrc

COPY --chown=${USERNAME}:${USERNAME} src/wheeltec ${WORKSPACE}/src

USER root
RUN --mount=type=cache,target=/var/cache/dnf,sharing=locked \
    set -exo pipefail; \
    qemu-ldconfig-fix enable; \
    su - ${USERNAME} -c "\
        cd ${WORKSPACE}/src && \
        mv mec_car-demo/* mec_car-demo/.[!.]* . 2>/dev/null && \
        rmdir mec_car-demo; \
        cd ${WORKSPACE}; \
        mkdir -p log build install; \
        source /opt/${ROS_PREFIX}/${ROS_DISTRO}/setup.bash; \
        agirosdep update; \
        agirosdep install --from-paths src --ignore-src -r -y; \
        unset PYTHONDONTWRITEBYTECODE; \
        colcon build --packages-select wheeltec_robot_msg; \
        source install/setup.bash; \
        colcon build --packages-select turn_on_wheeltec_robot; \
        source install/setup.bash; \
        colcon build --packages-select wheeltec_rrt_msg; \
        source install/setup.bash; \
        colcon build --parallel-workers ${PARALLEL_JOBS}; \
        source install/setup.bash; \
    "; \
    qemu-ldconfig-fix disable; \
    rm -rf /tmp/* /var/tmp/*

USER root
RUN cat > /ros_entrypoint.sh <<EOF
#!/bin/bash
set -e
source /opt/${ROS_PREFIX}/${ROS_DISTRO}/setup.bash
[ -f "${WORKSPACE}/install/setup.bash" ] && source ${WORKSPACE}/install/setup.bash
exec "\$@"
EOF
RUN chmod +x /ros_entrypoint.sh

USER ${USERNAME}
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD pgrep -f "agiros" || exit 1
ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]

# =============================================================================
# Stage 5: uav app 
